<?xml version="1.0"?>
<package format="3">
  <name>kinova_bringup</name>
  <version>0.0.0</version>
  <description>Bringup launch files and RViz config for the Kinova Gen3 robot system.</description>
  <maintainer email="jmill.pro1@gmail.com">mcrr-lab</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>kortex_description</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>kortex_controller</exec_depend>
  <exec_depend>gemini_live_robotics</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>